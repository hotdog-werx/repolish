# Task defaults, loaded by mise via `[env] _.file` in mise.toml.
# The devkit workspace provider will own this file: it routes task tool
# calls through the uv-toolbox environments. A repo that installs a tool
# in its own project overrides the variable to "" and the task calls the
# tool directly.
DK_UVTB_TOOLS_EXEC="uvtb exec -e tools --"
DK_UVTB_REPOLISH_EXEC="uvtb exec -e repolish --"
DK_COMPLEXIPY_THRESHOLD="20"
# Python stdio is cp1252 on Windows runners/terminals by default, and the
# tools print unicode (repolish summary trees, rich output): without UTF-8
# mode they die mid-summary with UnicodeEncodeError. Harmless on POSIX,
# which is already utf-8.
PYTHONUTF8="1"
